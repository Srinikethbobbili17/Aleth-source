# Local development credentials only. The application loads .env if present.
DATABASE_URL=postgres://rss:rss_dev_password@127.0.0.1:5432/rss
BIND_ADDR=127.0.0.1:3000
RUST_LOG=rss_backend=info,tower_http=info
# Automatic polling: refresh due feeds in the background (true/false).
POLLING=true
# Seconds between automatic refreshes of a healthy feed (60-86400; ±10% jitter).
POLL_INTERVAL_SECONDS=1800
